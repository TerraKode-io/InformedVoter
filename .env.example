# ═══════════════════════════════════════════════════════════════════════════
# InformedVoter — Application env (iv-app). Copy to `.env`.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database (self-hosted PostgreSQL 16 on iv-data, VLAN 120) ──
DATABASE_URL="postgresql://informedvoter:YOUR_DB_PASSWORD@10.39.112.20:5432/informedvoter?schema=public"

# ── Redis (self-hosted on iv-data, VLAN 120) ──
REDIS_URL="redis://:YOUR_REDIS_PASSWORD@10.39.112.20:6379"

# ── AI ──
ANTHROPIC_API_KEY=

# ── Data APIs ──
CONGRESS_GOV_API_KEY=
LEGISCAN_API_KEY=
GOOGLE_CIVIC_API_KEY=
FEC_API_KEY=

# ── CourtListener (optional; works without auth at lower rate limits) ──
COURTLISTENER_API_TOKEN=

# ── Cron job auth — generate with: openssl rand -base64 32 ──
CRON_SECRET=

# ── Email (Resend — cloud, remains external) ──
RESEND_API_KEY=
EMAIL_FROM="InformedVoter <notifications@knowyourgov.us>"

# ── Public base URL for email links ──
NEXT_PUBLIC_BASE_URL=https://knowyourgov.us

# ── Caddy TLS (Let's Encrypt DNS-01) — Cloudflare DNS-scoped token ──
# Token needs Zone:DNS:Edit for knowyourgov.us
CF_API_TOKEN=

# ── Umami analytics ──
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.knowyourgov.us/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_DATABASE_URL="postgresql://informedvoter:YOUR_DB_PASSWORD@10.39.112.20:5432/umami"
UMAMI_APP_SECRET=

# ⚠️  NEVER SET THIS IN PRODUCTION — bypasses auth on all /api/cron/* routes.
# ALLOW_MANUAL_CRON=true
