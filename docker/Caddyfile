# InformedVoter — Caddyfile
# TLS uses a single Cloudflare Origin CA certificate covering every project
# domain (SANs: 6 apexes + wildcards), mounted at /certs. Cloudflare SSL mode
# must be "Full (strict)" on all zones.
# ═══════════════════════════════════════════════════════════════════════════

{
	email admin@knowyourgov.us
}

# ── Main site: all project domains ──────────────────────────────────────────
knowyourgov.us www.knowyourgov.us govguide.online www.govguide.online governmentmadeclear.com www.governmentmadeclear.com govmadeclear.com www.govmadeclear.com knowourgov.com www.knowourgov.com knowyourgov.online www.knowyourgov.online {
	encode zstd gzip
	tls /certs/civicsites.pem /certs/civicsites.key
	reverse_proxy app:3000
}

# ── Umami analytics ─────────────────────────────────────────────────────────
analytics.knowyourgov.us {
	encode zstd gzip
	tls /certs/civicsites.pem /certs/civicsites.key
	reverse_proxy umami:3000
}
