# ═══════════════════════════════════════════════════════════════════════════
# InformedVoter — Caddyfile
# TLS uses a Cloudflare Origin CA certificate (valid 15 years), mounted at
# /certs. Cloudflare SSL mode must be "Full (strict)".
# ═══════════════════════════════════════════════════════════════════════════

{
	email admin@knowyourgov.us
}

# ── Main site ───────────────────────────────────────────────────────────────
knowyourgov.us {
	encode zstd gzip
	tls /certs/knowyourgov.pem /certs/knowyourgov.key
	reverse_proxy app:3000
}

# ── www → apex ──────────────────────────────────────────────────────────────
www.knowyourgov.us {
	encode zstd gzip
	tls /certs/knowyourgov.pem /certs/knowyourgov.key
	redir https://knowyourgov.us{uri} permanent
}

# ── Umami analytics ─────────────────────────────────────────────────────────
analytics.knowyourgov.us {
	encode zstd gzip
	tls /certs/knowyourgov.pem /certs/knowyourgov.key
	reverse_proxy umami:3000
}
