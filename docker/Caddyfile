# ═══════════════════════════════════════════════════════════════════════════
# InformedVoter — Caddyfile
# TLS via Let's Encrypt DNS-01 (Cloudflare), because the origin is only
# reachable through Cloudflare (Full strict).
# ═══════════════════════════════════════════════════════════════════════════

{
	email admin@knowyourgov.us
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	debug
}

# ── Main site ───────────────────────────────────────────────────────────────
knowyourgov.us {
	encode zstd gzip
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		propagation_timeout -1
	}
	reverse_proxy app:3000
}

# ── www → apex ──────────────────────────────────────────────────────────────
www.knowyourgov.us {
	encode zstd gzip
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		propagation_timeout -1
	}
	redir https://knowyourgov.us{uri} permanent
}

# ── Umami analytics ─────────────────────────────────────────────────────────
analytics.knowyourgov.us {
	encode zstd gzip
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		propagation_timeout -1
	}
	reverse_proxy umami:3000
}
